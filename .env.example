# Copy to .env and fill in only what you have. The demo runs without an AI key.
PORT=8000

# Alibaba Cloud Model Studio (DashScope) OpenAI-compatible endpoint.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# Optional override; defaults to 8000 for DashScope and 30000 for the gateway.
# AI_TIMEOUT_MS=30000

# Alternative: use the Qoder gateway with DASHSCOPE_API_KEY left empty.
QODER_API_KEY=
QODER_HOST=
OPENAI_ENDPOINT=
# OPENAI_BASE_URL overrides QODER_HOST + OPENAI_ENDPOINT.
OPENAI_BASE_URL=
WATCHDOG_MODEL=qwen3.8-flash

# Comma-separated browser origins allowed to call the API.
ALLOW_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost:3000

# Optional Meta test-number pilot. See docs/whatsapp-test-pilot.md.
WHATSAPP_ENABLED=false
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
# Pin a supported version for your Meta app; this is the get-started example.
WHATSAPP_GRAPH_VERSION=v23.0
# Verified and consented test recipients, international digits only, comma-separated.
WHATSAPP_ALLOWED_SENDERS=
# Absolute file path in a precreated, private, persistent directory (not /tmp).
WHATSAPP_DB_PATH=
# auto sends submitted text to the configured AI provider; requires separate consent.
WHATSAPP_ANALYSIS_MODE=rules
